# 识别服务（server/index.mjs / Cloudflare Worker / Supabase 函数）使用；不要提交真实密钥
# 二选一：Google Gemini（推荐，有免费额度）或 Anthropic Claude
GEMINI_API_KEY=
# 可选：GEMINI_MODEL 默认 gemini-3.8-flash；GEMINI_THINKING=low|medium|high
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 两个密钥都填时用哪个：gemini（默认）或 anthropic
AI_PROVIDER=
PORT=8787
# 前端与服务不同域时，允许的来源（逗号分隔）
ALLOWED_ORIGINS=https://your-name.github.io
# 访问口令（逗号分隔可填多个）
ACCESS_TOKEN=
MAX_IMAGE_BYTES=6000000
RECOGNIZE_TIMEOUT_MS=90000
RATE_PER_MIN=10
